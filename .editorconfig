root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,json,css,yml,yaml}]
indent_style = space
indent_size = 2

[*.java]
indent_style = space
indent_size = 4

[*.xml]
indent_style = tab

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
