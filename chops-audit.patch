diff --git a/apps/web/src/utils/safeStorage.ts b/apps/web/src/utils/safeStorage.ts
new file mode 100644
index 0000000..0a9f7ed
--- /dev/null
+++ b/apps/web/src/utils/safeStorage.ts
@@ -0,0 +1,16 @@
+/** localStorage can throw (blocked storage, privacy modes). Never let it break the app. */
+export function readStorage(key: string): string | null {
+  try {
+    return localStorage.getItem(key);
+  } catch {
+    return null;
+  }
+}
+
+export function writeStorage(key: string, value: string): void {
+  try {
+    localStorage.setItem(key, value);
+  } catch {
+    /* preference is simply not persisted */
+  }
+}
